# Sembunyikan file status sinkronisasi dari FTP-Deploy-Action agar tidak bisa dibuka publik.
<Files ".ftp-deploy-sync-state.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</Files>

# JANGAN menambahkan DirectoryIndex atau Options di sini.
# File ini berada di web root, jadi berlaku juga untuk folder subdomain (resto, titipgracia,
# warehouse-management, dst). Mengubah DirectoryIndex atau mematikan Indexes membuat aplikasi
# PHP di subdomain itu menjawab 403 Forbidden.
